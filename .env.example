# Database Configuration (For Cloud Postgres e.g. Neon, Supabase, Render, Railway, AWS RDS)
# Example Cloud DB: jdbc:postgresql://ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/keystone_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgresql_password
SPRING_PROFILES_ACTIVE=default

# JWT Security
JWT_SECRET=WEYN2/9hxem8JPQ14rA6/fGAJVG31btpBYIgh6aODYF7LMpGLgqzifYn6V6P7/HLwR4PKuht4bpgRf/qNIlSSQ==
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Backend CORS: Frontend URLs allowed to call Backend APIs (comma-separated, or * for all)
# Example for hosted frontend: https://my-keystone-app.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend API Base URL (Backend Internet URL when hosted)
# Example for hosted backend: https://keystone-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api
